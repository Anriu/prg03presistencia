<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <!-- Unidade de persistência -->
    <persistence-unit name="prg03persistencia">

        <!-- Classe entidade mapeada -->
        <class>br.com.ifba.curso.entity.Curso</class>

        <properties>

            <!-- Driver do banco PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <!-- URL de conexão com o banco -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/postgres"/>

            <!-- Usuário do banco -->
            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <!-- Senha do banco -->
            <property name="jakarta.persistence.jdbc.password"
                      value="root"/>

            <!-- Exibe os comandos SQL no console -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <!-- Formata os comandos SQL -->
            <property name="hibernate.format_sql"
                      value="true"/>

            <!-- Atualiza automaticamente as tabelas -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

        </properties>

    </persistence-unit>

</persistence>